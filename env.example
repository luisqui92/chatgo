# ─── WhatsApp Meta API ───────────────────────────────
WHATSAPP_TOKEN=tu_token_de_meta
WHATSAPP_PHONE_ID=tu_phone_id
VERIFY_TOKEN=chatgo2024

# ─── Google Maps ─────────────────────────────────────
GOOGLE_MAPS_KEY=tu_api_key_google_maps

# ─── Wialon ──────────────────────────────────────────
WIALON_TOKEN=tu_token_wialon

# ─── OpenAI ──────────────────────────────────────────
OPENAI_KEY=tu_api_key_openai

# ─── MongoDB Atlas ───────────────────────────────────
MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/chatgo

# ─── Admin ───────────────────────────────────────────
ADMIN_PHONE=591XXXXXXXXX  # tu número sin + para aprobar pagos

# ─── QR BCP ──────────────────────────────────────────
QR_IMAGE_URL=https://url-de-tu-imagen-qr-bcp.com/qr.jpg

# ─── Pago diario chofer ──────────────────────────────
CUOTA_DIARIA_BS=10
# Secreto compartido con el macro de MacroDroid que manda la notificación
# de Yape al webhook /webhook/pago-yape para auto-aprobar el pago
PAGO_WEBHOOK_SECRET=elige_un_secreto_largo_y_aleatorio

# ─── Puerto ──────────────────────────────────────────
PORT=3000

# ─── Plataforma modular (trabajo en las sombras) ─────
# Módulos activos además del taxi, separados por coma.
# Vacío o sin definir = solo taxi (comportamiento actual, cero cambios).
# Disponibles: favor, ambulancia, delivery, bus, school, empresas, rastreo
# MODULOS_ACTIVOS=favor,ambulancia,delivery,bus,school,empresas,rastreo

# Tarifa base en Bs que se suma al costo por km en mandados (módulo favor)
# FAVOR_TARIFA_BASE_BS=5
