// ChatGo — Schema Prisma (MySQL)
// Migrado desde db/models.js (Mongoose/MongoDB).
// Convenciones:
//  - id: String @id @default(uuid()) en todos los modelos, para mantener el mismo
//    patrón de "id opaco" que ya usa el código (chofer._id, candidato._id, etc.)
//  - Objetos embebidos que se filtran/ordenan en queries (pagoDiario, origen/destino,
//    posicion) se aplanan en columnas reales para que sean indexables en SQL.
//  - Arrays/objetos que solo se leen/escriben como blob (familiaresVinculados,
//    recargas, rutasFrecuentes, lugaresFrecuentes, paradas, eventosSeguridad,
//    rutaPuntos, ofertasRechazadas) se guardan como columnas Json.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id                  String    @id @default(uuid())
  phone               String    @unique
  nombre              String?
  aceptoTerminos      Boolean   @default(false)
  fechaRegistro       DateTime  @default(now())
  audioOnboardingHecho Boolean  @default(false)
  modoAdultoMayor     Boolean   @default(false)
  respuestasPorVoz    Boolean   @default(false)
  saldo               Float     @default(0)
  familiaresVinculados Json?    // [{ phone, nombre, fechaVinculo }]
  recargas            Json?     // [{ monto, familiarPhone, fecha, comprobante }]
  ciudad              String?
  ciudadDetectada     Boolean   @default(false)
  viajesTotal         Int       @default(0)
  rutasFrecuentes     Json?     // [{ origen, destino, contador, horas:[Int], tipoVehiculo, ultimoViaje }]
  lugaresFrecuentes   Json?     // { casa, trabajo, otros:[{alias,lat,lng,nombre}] }
  ultimoViajeAt       DateTime?
  promoReactivacionEnviada Boolean @default(false)
  pushWeb             Json?     // suscripción Web Push del navegador (pedidos web)
  ultimoPedidoAgua    Json?     // último pedido de ChatGo Agua (para "lo de siempre")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@map("usuarios")
}

model Chofer {
  id                          String    @id @default(uuid())
  phone                       String    @unique
  wialonId                    String?   @unique
  traccarId                   String?   @unique
  fotoChofer                  String?
  fotoVehiculo                String?
  placa                       String?
  nombre                      String?
  tipoVehiculo                String    @default("auto") // auto | moto
  colorVehiculo               String    @default("")
  estado                      String    @default("offline")
  pagoDiarioFecha             DateTime?
  pagoDiarioFechaStr          String?
  pagoDiarioPagado            Boolean   @default(false)
  pagoDiarioAprobado          Boolean   @default(false)
  pagoDiarioComprobanteValidado Boolean @default(false)
  viajesTotal                 Int       @default(0)
  aceptoTerminos               Boolean  @default(false)
  fechaRegistro                DateTime @default(now())
  viajeReservado                String?
  reservadoHasta                DateTime?
  ratingPromedio                Float    @default(0)
  ratingCantidad                Int      @default(0)
  flota                         String?
  ultimaAlertaZona               DateTime?
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  @@index([estado])
  @@index([flota])
  @@index([pagoDiarioFechaStr, pagoDiarioAprobado, pagoDiarioPagado, pagoDiarioComprobanteValidado])
  @@map("choferes")
}

model Viaje {
  id                      String    @id @default(uuid())
  usuarioPhone            String?
  choferPhone             String?
  choferWialonId          String?
  choferTraccarId         String?
  choferNombre            String?
  choferPlaca             String?
  ciudad                  String?
  origenLat               Float?
  origenLng               Float?
  origenNombre            String?
  destinoLat              Float?
  destinoLng              Float?
  destinoNombre           String?
  paradas                 Json?     // [{lat,lng,nombre}]
  observaciones           String?   @db.Text
  distanciaKm             Float?
  precioBase              Float?
  descuentoBs             Float     @default(0)
  codigoPromoUsado        String?
  precioTotal             Float?
  precioPorKm             Float?
  tipoVehiculo            String    @default("auto") // auto | moto
  estado                  String    @default("pendiente")
  fechaInicio             DateTime  @default(now())
  fechaAsignacion         DateTime?
  fechaAceptacion         DateTime?
  fechaInicioViaje        DateTime?
  tiempoEstimadoMin       Float?
  fechaFin                DateTime?
  llegadaNotificada       Boolean   @default(false)
  llegadaOrigenNotificada Boolean   @default(false)
  cancelacionMotivo       String?
  ratingPasajero          Float?
  comentarioPasajero      String?   @db.Text
  ratingSolicitado        Boolean   @default(false)
  codigoPromoGenerado     String?
  rutaPolilinea           String?   @db.Text
  rutaPuntos              Json?     // [{lat,lng}]
  nivelAlerta             String    @default("verde") // verde|amarillo|naranja|rojo
  eventosSeguridad        Json?     // [{tipo,nivel,detalle,lat,lng,timestamp}]
  detenidoDesde           DateTime?
  ultimaPosicionLat       Float?
  ultimaPosicionLng       Float?
  ultimaPosicionAt        DateTime?
  panicoActivado          Boolean   @default(false)
  panicoAt                DateTime?
  extendidoPorTrafico     Boolean   @default(false)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([estado, fechaAsignacion])
  @@index([usuarioPhone, estado])
  @@index([choferPhone, estado])
  @@index([ciudad])
  @@index([nivelAlerta])
  @@map("viajes")
}

model CodigoPromo {
  id                  String    @id @default(uuid())
  codigo              String    @unique
  descuentoPorcentaje Int       @default(40)
  generadoPor         String?
  tipoOrigen          String    @default("post_viaje")
  fechaCreacion       DateTime  @default(now())
  fechaVencimiento    DateTime?
  usado               Boolean   @default(false)
  usadoPor            String?
  fechaUso            DateTime?
  viajeIdAsociado     String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([generadoPor])
  @@index([fechaVencimiento])
  @@index([usado])
  @@map("codigospromo")
}

model SessionState {
  id        String   @id @default(uuid())
  phone     String   @unique
  data      Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sessionstates")
}

model ListaEspera {
  id                    String    @id @default(uuid())
  userPhone             String    @unique
  ciudad                String?
  origenLat             Float?
  origenLng             Float?
  origenNombre          String?
  destinoLat            Float?
  destinoLng            Float?
  destinoNombre         String?
  distancia             Float?
  precio                Float?
  precioPorKm           Float?
  tipoVehiculoSolicitado String?  // auto | moto | null
  timestamp             DateTime  @default(now())
  notificado            Boolean   @default(false)
  ofertaActivaWialonId  String?
  ofertaActivaHasta     DateTime?
  ofertasRechazadas     Json?     // [String]
  ultimoMensajeAt       DateTime?
  cancelando            Boolean   @default(false)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([ciudad])
  @@index([timestamp])
  @@index([ofertaActivaWialonId, timestamp])
  @@map("listaesperas")
}

model RateLimit {
  id        String   @id @default(uuid())
  phone     String   @unique
  horaStr   String?
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ratelimits")
}

model LocationReference {
  id                String   @id @default(uuid())
  referencia        String
  referenciaOriginal String?
  lat               Float?
  lng               Float?
  nombreResuelto    String?
  contador          Int      @default(1)
  ciudad            String   @default("Cochabamba")
  precargado        Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([referencia, ciudad])
  @@map("locationreferences")
}

model Demanda {
  id                   String   @id @default(uuid())
  zona                 String
  hora                 Int
  diaSemana            Int
  cantidad             Int      @default(1)
  ultimaActualizacion  DateTime @default(now())

  @@index([zona, hora, diaSemana])
  @@map("demandas")
}

model EventoChofer {
  id              String   @id @default(uuid())
  choferPhone     String
  tipo            String?  // aceptado|rechazado|cancelado|completado|timeout
  viajeId         String?
  zona            String?
  tiempoRespuesta Float?
  timestamp       DateTime @default(now())

  @@index([choferPhone])
  @@index([timestamp])
  @@map("eventochofers")
}

model AlertaSeg {
  id                 String   @id @default(uuid())
  viajeId            String?
  tipo               String?  // desvio|tiempo_excesivo|parada_sospechosa|trafico|gps_perdido|velocidad_anormal
  descripcion        String?
  posicionLat        Float?
  posicionLng        Float?
  notificadoPasajero Boolean  @default(false)
  notificadoAdmin    Boolean  @default(false)
  timestamp          DateTime @default(now())

  @@index([viajeId])
  @@map("alertasegs")
}

model Surge {
  id               String    @id @default(uuid())
  zona             String    @default("general")
  multiplier       Float     @default(1.0)
  motivo           String?
  viajesAfectados  Int       @default(0)
  vigenteHasta     DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([zona, vigenteHasta])
  @@map("surges")
}

model ViajeDemo {
  id            String   @id @default(uuid())
  diaId         Int
  choferIdx     Int?
  choferNombre  String?
  choferPlaca   String?
  choferTipo    String?
  usuarioNombre String?
  usuarioPhone  String?
  origenNombre  String?
  origenLat     Float?
  origenLng     Float?
  destinoNombre String?
  destinoLat    Float?
  destinoLng    Float?
  distanciaKm   Float?
  precioTotal   Float?
  estado        String?
  rating        Float?
  tInicio       Float?
  tAceptado     Float?
  tLlegoOrigen  Float?
  tSubioPasajero Float?
  tCompletado   Float?
  choferPosLat  Float?
  choferPosLng  Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([diaId, estado])
  @@map("viajedemos")
}

model EsquinaMapeada {
  id            String   @id @default(uuid())
  llave         String   @unique
  calle1        String?
  calle2        String?
  zona          String?
  ciudad        String   @default("Cochabamba")
  lat           Float?
  lng           Float?
  usos          Int      @default(1)
  primerUsuario String?
  ultimoUso     DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("esquinamapeadas")
}

model PreRegistroFlota {
  id        String   @id @default(uuid())
  phone     String   @unique
  flota     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("preregistroflotas")
}

model Flota {
  id        String   @id @default(uuid())
  codigo    String   @unique
  nombre    String
  token     String   @unique
  activa    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("flotas")
}

// Notificaciones bancarias (Yape vía MacroDroid) sin chofer pendiente todavía.
// MySQL no tiene TTL nativo como Mongo: la limpieza de filas viejas (>20 min)
// se hace en services/session.js con un interval, igual que el resto de la app.
model NotificacionPago {
  id        String   @id @default(uuid())
  texto     String?  @db.Text
  monto     Float?
  usado     Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([usado, createdAt])
  @@map("notificacionespago")
}

// ─── PLATAFORMA MODULAR ──────────────────────────────────────────────────────
// Solicitudes de servicios no-taxi (favor, delivery, school, empresas, rastreo,
// salud, reporte). Tabla genérica: lo específico de cada módulo va en `detalle`.
model Solicitud {
  id            String   @id @default(uuid())
  tipo          String   // favor | delivery | school | empresa | rastreo | salud | reporte
  usuarioPhone  String
  estado        String   @default("nueva") // nueva | cotizada | confirmada | asignada | en_curso | completada | cancelada
  detalle       Json?
  origenLat     Float?
  origenLng     Float?
  origenNombre  String?
  destinoLat    Float?
  destinoLng    Float?
  destinoNombre String?
  precioBs      Float?
  asignadoPhone String?
  viajeId       String?  // si el módulo generó un viaje del motor taxi (ej: favor)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tipo, estado])
  @@index([usuarioPhone])
  @@map("solicitudes")
}

// ─── DELIVERY: catálogo de restaurantes y menús ──────────────────────────────
model Restaurante {
  id         String   @id @default(uuid())
  nombre     String
  categorias String?  // etiquetas separadas por coma: "pollo,broaster,comida rapida"
  telefono   String?
  lat        Float?
  lng        Float?
  zona       String?
  horario    String?  // texto informativo: "11:00 a 22:00"
  activo     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  platos     Plato[]

  @@index([activo])
  @@map("restaurantes")
}

model Plato {
  id            String      @id @default(uuid())
  restauranteId String
  restaurante   Restaurante @relation(fields: [restauranteId], references: [id])
  nombre        String
  descripcion   String?
  precioBs      Float
  etiquetas     String?     // "pollo,entero,broaster" — para el buscador por antojo
  activo        Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([restauranteId, activo])
  @@map("platos")
}

// ─── ChatGo Auxilio Mecánico (Etapa 1) ──────────────────────────────────────
model Mecanico {
  id                   String    @id @default(uuid())
  nombre               String
  telefono             String    @unique          // WhatsApp con código de país (591...)
  zona                 String?                     // zona de Santa Cruz donde opera
  ubicacionBase        Json?                       // { lat, lng }
  tiposServicio        Json?                       // ["llanta","bateria","mecanica_general","grua","cerrajeria"]
  atiende24h           Boolean   @default(false)
  documentos           Json?                       // { facturaLuz, carnet, nit, verificacionFisica, notasVerificacion }
  suscripcion          Json?                       // { estado, fechaInicio, fechaVencimiento }
  calificacionPromedio Float?
  totalAuxilios        Int       @default(0)
  activo               Boolean   @default(true)
  auxilios             Auxilio[]
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([zona])
  @@map("mecanicos")
}

model Auxilio {
  id                    String    @id @default(uuid())
  telefonoVarado        String
  ubicacion             Json?                       // { lat, lng, descripcion }
  tipoProblema          String?                     // "llanta","bateria","no_arranca","grua","otro"
  estado                String    @default("pendiente") // pendiente|asignado|en_camino|completado|cancelado
  mecanicoId            String?
  mecanico              Mecanico? @relation(fields: [mecanicoId], references: [id])
  calificacion          Int?                        // 1-5
  comentarioCalificacion String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([estado])
  @@map("auxilios")
}

// ─── ChatGo Agua (pedidos para despacho y control de rutas) ──────────────────
model PedidoAgua {
  id              String    @id @default(uuid())
  telefono        String                        // cliente
  producto        String                        // key del catálogo
  productoNombre  String
  cantidad        Int       @default(1)
  total           Float     @default(0)
  lat             Float?
  lng             Float?
  direccion       String?
  metodoPago      String?
  estado          String    @default("nuevo")   // nuevo|en_ruta|entregado|cancelado
  repartidor      String?                        // teléfono del repartidor asignado
  programadoPara  DateTime?                      // agenda (Google Calendar)
  calendarEventId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([estado])
  @@map("pedidos_agua")
}

// ─── Evaluación de Ventas (sistema SEPARADO de ChatGo, solo reusa el servidor) ─
model Vendedor {
  id           String            @id @default(uuid())
  nombre       String
  email        String            @unique
  whatsapp     String?
  telefono     String?
  cargo        String?
  zona         String?
  foto         String?           @db.Text // avatar en base64 (data URL)
  fechaIngreso DateTime?
  activo       Boolean           @default(true)
  evaluaciones EvaluacionVenta[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@map("vendedores")
}

model EvaluacionVenta {
  id                String   @id @default(uuid())
  vendedorId        String
  vendedor          Vendedor @relation(fields: [vendedorId], references: [id])
  fechaConversacion DateTime?
  tiempoRespuesta   Int      @default(0)
  descubrimiento    Int      @default(0)
  objeciones        Int      @default(0)
  seguimiento       Int      @default(0)
  cierre            Int      @default(0)
  cumplimiento      Int      @default(0)
  promedio          Float    @default(0)
  fortalezas        Json?    // [{ texto, cita }]
  debilidades       Json?    // [{ texto, cita }]
  mejoraConcreta    String?  @db.Text
  conversacion      String?  @db.Text
  analisis          Json?    // { probabilidadCierre, factores, emocionCliente, emocionEvolucion, respuestaIdeal, dineroPerdido, resumenEjecutivo, alertasRiesgo }
  convId            String?  // identidad de la conversación (para continuar donde quedó)
  convHash          String?  // hash del chat completo (para detectar repetidos idénticos)
  createdAt         DateTime @default(now())

  @@index([vendedorId])
  @@index([convId])
  @@map("evaluaciones_venta")
}

// Línea de WhatsApp enlazada por Baileys a un vendedor (dispositivo vinculado).
// Aislada de ChatGo: cada línea es su propia sesión, con su carpeta de credenciales.
model LineaVentas {
  id         String       @id @default(uuid())
  vendedorId String
  numero     String?      // número detectado al conectar (jid)
  estado     String       @default("desconectado") // desconectado | qr | conectado
  activa     Boolean      @default(true)
  chats      ChatVentas[]
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([vendedorId])
  @@map("lineas_ventas")
}

// Transcripción acumulada de una conversación (vendedor ↔ cliente) capturada en vivo.
// Se persiste para no perder mensajes ante un reinicio; la evaluación incremental
// se apoya en EvaluacionVenta (convId) para calificar solo lo nuevo.
model ChatVentas {
  id           String      @id @default(uuid())
  lineaId      String
  linea        LineaVentas @relation(fields: [lineaId], references: [id])
  clienteJid   String      // remoteJid del cliente
  clienteNombre String?
  texto        String?     @db.Text // transcripción acumulada
  ultimoMsgAt  DateTime?
  pendiente    Boolean     @default(false) // hay mensajes nuevos sin evaluar
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([lineaId, clienteJid])
  @@index([lineaId])
  @@map("chats_ventas")
}

// ─── Corte de Aluminio (panel de despiece/optimización, separado — reusa el servidor) ─
// Catálogo de perfiles de aluminio. La barra estándar es de 6 m (6000 mm).
model PerfilAluminio {
  id          String   @id @default(uuid())
  codigo      String?  // código del proveedor
  nombre      String   // ej: "Riel superior 3 vías", "Jamba 2 vías"
  linea       String?  // serie/sistema, ej: "Serie 25", "Vitri"
  color       String?  @default("natural")
  largoBarraMm Int     @default(6000)
  precioBarra Float    @default(0) // Bs por barra completa
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("carp_perfiles")
}

model VidrioCarp {
  id        String   @id @default(uuid())
  nombre    String   // ej: "Vidrio 4mm incoloro", "Templado 6mm"
  precioM2  Float    @default(0) // Bs por m²
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("carp_vidrios")
}

model AccesorioCarp {
  id        String   @id @default(uuid())
  nombre    String   // ej: "Rueda corrediza", "Felpa (m)", "Cerradura"
  unidad    String   @default("u") // u, m, jgo, par
  precio    Float    @default(0)
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("carp_accesorios")
}

// Receta de un tipo de producto (ventana/puerta). Guarda las piezas de perfil
// con su fórmula de corte (en función de A=ancho y H=alto en mm), los vidrios y
// los accesorios. Se edita desde el panel.
model ProductoCarp {
  id          String   @id @default(uuid())
  nombre      String   // ej: "Ventana corrediza 2 hojas"
  descripcion String?
  piezas      Json     @default("[]") // [{ perfilId, cantidad, formula, nota }]
  vidrios     Json     @default("[]") // [{ vidrioId, cantidad, formulaAncho, formulaAlto }]
  accesorios  Json     @default("[]") // [{ accesorioId, cantidad, formula }]
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("carp_productos")
}

// Cotización guardada: cliente + ítems + resultado calculado (despiece, barras, costo).
model CotizacionCarp {
  id          String   @id @default(uuid())
  cliente     String?
  telefono    String?
  items       Json     @default("[]") // [{ productoId, nombre, ancho, alto, cantidad }]
  resultado   Json?    // { perfiles:[{...barras, desperdicio}], vidrioM2, accesorios, costos }
  descuento   Float    @default(0) // % de descuento comercial
  manoObra    Float    @default(0) // Bs de mano de obra
  total       Float    @default(0)
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@map("carp_cotizaciones")
}
